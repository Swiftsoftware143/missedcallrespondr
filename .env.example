# missedcallrespondr — environment TEMPLATE (placeholders only, safe to publish)
#
# Real values are NEVER committed. The deployment source of truth on this host is
#   /etc/swift/env/missedcall.env          (mode 600, read by the container at start)
# Copy this file to .env for a local run and fill in real values; .env is gitignored.
#
# Kanban t_b9b18e04: a .env carrying the values below-as-placeholders used to be
# tracked AND published on origin/main. Every credential in it was measured dead
# before it was removed (DB password rejected by the live Postgres, JWT_SECRET was
# not either app's signing key, REDIS_URL had no password while the live Redis
# requires one) — see /opt/swift/audits/cs8164-scanners-t_b9b18e04/REPORT.md

# --- read by src/config.rs -------------------------------------------------
DATABASE_URL=postgres://swift:CHANGE_ME@localhost:5432/missedcallrespondr
JWT_SECRET=CHANGE_ME_strong_random_32_bytes_min
SERVER_PORT=8088
SERVER_HOST=0.0.0.0

# --- read by the rest of src/ ----------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
INTERNAL_SYNC_KEY=CHANGE_ME
PROVIDER_KEY_ENC_SECRET=CHANGE_ME_64_hex
CORESWIFT_URL=http://127.0.0.1:8081
FUNNELSWIFT_URL=http://127.0.0.1:8080
WORKFLOWSWIFT_URL=http://127.0.0.1:8082
EMAIL_API_URL=CHANGE_ME
EMAIL_API_KEY=CHANGE_ME
EMAIL_API_AUTH=CHANGE_ME
EMAIL_FROM=CHANGE_ME

# --- deploy-time knobs (see /etc/swift/env/missedcall.env) ------------------
PORT=8088
HOST=127.0.0.1
RUST_LOG=info
DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTIONS=5
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=604800
